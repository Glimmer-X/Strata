      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space returns once it’s emptied"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "空にすると容量が戻ります"
