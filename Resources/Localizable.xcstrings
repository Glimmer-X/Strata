        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン"
          }
        }
      }
    },
    "扫描读不到的部分": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Space the scan can’t read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンで読めない領域"
          }
        }
      }
    },
    "扫描还没数到这一部分": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The scan hasn’t reached this part yet"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャンがまだ届いていない部分"
          }
        }
      }
    },
    "把“%@”移到废纸篓？": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move “%@” to the Trash?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」をゴミ箱に入れますか？"
