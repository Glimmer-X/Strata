{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "%@ · %@": {
      "shouldTranslate": false
    },
    "%@扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にスキャン"
          }
        }
      }
    },
    "%lld 个小项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld small items"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "小さな項目 %lld 個"
          }
        }
      }
    },
    "App 会按需重新生成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Apps rebuild them as needed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリが必要に応じて作り直します"
          }
        }
      }
    },
    "Strata": {
      "shouldTranslate": false
    },
    "Xcode 下次编译时会重新生成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode rebuilds it on the next build"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "次のビルドで Xcode が作り直します"
          }
        }
      }
    },
    "Xcode 编译缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Build Cache"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode のビルドキャッシュ"
          }
        }
      }
    },
    "Xcode 设备支持文件": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode Device Support"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Xcode のデバイスサポート"
          }
        }
      }
    },
    "›": {
      "shouldTranslate": false
    },
    "⌘O": {
      "shouldTranslate": false
    },
    "先打开“完全磁盘访问权限”": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn on Full Disk Access first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まず「フルディスクアクセス」をオンに"
          }
        }
      }
    },
    "刚刚扫描": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned just now"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "たった今スキャン"
          }
        }
      }
    },
    "占整个文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of the folder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダ全体に占める割合"
          }
        }
      }
    },
    "占整块磁盘": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Of the disk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ディスク全体に占める割合"
          }
        }
      }
    },
    "取消": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キャンセル"
          }
        }
      }
    },
    "只在排查问题时有用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only useful for troubleshooting"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "問題を調べるときにだけ使います"
          }
        }
      }
    },
    "可以清理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Safe to Clean"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "削除できるもの"
          }
        }
      }
    },
    "可用": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可能"
          }
        }
      }
    },
    "可用 %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ available"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用可能 %@"
          }
        }
      }
    },
    "回到上一层": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go Up"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の階層へ"
          }
        }
      }
    },
    "回到上一层（Esc）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Go up (Esc)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "上の階層へ（Esc）"
          }
        }
      }
    },
    "在访达中显示": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show in Finder"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Finder に表示"
          }
        }
      }
    },
    "大小": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Size"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サイズ"
          }
        }
      }
    },
    "它们可能正在使用，或受系统保护。其余的已经清理好了。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "They may be in use or protected by the system. Everything else was cleaned."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "使用中か、システムで保護されている可能性があります。それ以外は削除しました。"
          }
        }
      }
    },
    "它占 %@。清空废纸篓之后，空间才会腾出来。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It takes up %@. The space is freed once you empty the Trash."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ あります。ゴミ箱を空にすると空き容量になります。"
          }
        }
      }
    },
    "已扫到": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン済み"
          }
        }
      }
    },
    "已经打开了": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It’s On"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンにしました"
          }
        }
      }
    },
    "应用缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "App Caches"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アプリのキャッシュ"
          }
        }
      }
    },
