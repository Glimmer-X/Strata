      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trash"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱"
          }
        }
      }
    },
