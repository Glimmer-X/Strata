          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ログ"
          }
        }
      }
    },
    "暮色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dusk"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夕暮れ"
          }
        }
      }
    },
    "最大的": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Largest"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大きい順"
          }
        }
      }
    },
    "有 %lld 项没能清理": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld items couldn’t be cleaned"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 個の項目を削除できませんでした"
          }
        }
      }
    },
    "本地快照、系统卷和读不到的文件夹": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local snapshots, system volumes and folders that can’t be read"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ローカルスナップショット、システムボリューム、読めないフォルダ"
