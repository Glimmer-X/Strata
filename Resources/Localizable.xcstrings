        }
      }
    },
    "模拟器缓存": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Simulator Caches"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シミュレータのキャッシュ"
          }
        }
      }
    },
    "模拟器需要时会重新生成": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilt by Simulator when needed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なときにシミュレータが作り直します"
          }
        }
      }
    },
    "正在扫描 · 已经看过 %@ 项": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning · %@ items so far"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中・%@ 項目を確認"
          }
        }
      }
    },
    "正在扫描…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanning…"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スキャン中…"
          }
        }
      }
    },
    "正在更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Updating"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "更新中"
          }
        }
      }
    },
    "气泡": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bubbles"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バブル"
          }
        }
      }
    },
    "没有它，大部分文件夹都看不到。Strata 只读名字和大小，不打开文件内容。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it most folders stay out of sight. Strata reads names and sizes only, never what is inside a file."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフのままでは、ほとんどのフォルダが見えません。Strata が読むのは名前とサイズだけで、ファイルの中身は開きません。"
          }
        }
      }
    },
    "没能移到废纸篓": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn’t move it to the Trash"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に入れられませんでした"
          }
        }
      }
    },
    "流动": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flow"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フロー"
          }
